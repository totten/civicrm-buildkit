#!/usr/bin/env bash
set -x

mysqld_base="$1"
if [ -z "$1" ]; then
  echo >&2 "Usage: $0 <base-dir>"
  exit 1
fi

mysql_version=$(mysql --no-defaults --version)

mkdir -p "$LOCO_SVC_VAR"/run
mkdir -p "$mysqld_base"/{conf,log,tmp}

php "$LOCO_CFG/mysql-common/my.cnf.php" > "$mysqld_base/conf/my.cnf"

## MySQL v5.7
if echo "$mysql_version" | grep 'Distrib 5.7' -q; then
  mysqld --defaults-file="$mysqld_base/conf/my.cnf" --initialize-insecure --explicit_defaults_for_timestamp --datadir="$mysqld_base/data"

elif echo "$mysql_version" | grep 'Ver [89].' -q; then
  #mysqld --no-defaults --initialize-insecure --explicit_defaults_for_timestamp --datadir="$mysqld_base/data"
  mysqld --defaults-file="$mysqld_base/conf/my.cnf" --initialize-insecure --explicit_defaults_for_timestamp --datadir="$mysqld_base/data"

## MariaDB
elif echo "$mysql_version" | grep 'MariaDB' -q; then
  mysql_bin=$(dirname $(which mysqld))
  mysql_base=$(dirname "$mysql_bin")
  pushd "$mysql_base"
    set -ex
      mysql_install_db --datadir="$mysqld_base/data" --defaults-file="$mysqld_base/conf/my.cnf" --skip-name-resolve --auth-root-authentication-method=normal
    set +ex
  popd

## Older MySQL?
else
  mysql_bin=$(dirname $(which mysqld))
  mysql_base=$(dirname "$mysql_bin")
  pushd "$mysql_base"
    set -ex
      mysql_install_db --datadir="$mysqld_base/data" --defaults-file="$mysqld_base/conf/my.cnf" --skip-name-resolve
    set +ex
  popd
fi
